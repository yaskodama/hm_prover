open Syntax
let show_ty (t:Types.ty) =
  let rec f = function
    | Types.TInt -> "int" | Types.TBool -> "bool"
    | Types.TVar a -> "'"^string_of_int a
    | Types.TFun(t1,t2) -> "("^f t1^"->"^f t2^")" in f t
let () =
  let id = ELam ("x", EVar "x") in
  let expr = EApp (id, EInt 3) in
  let env = Env.empty |
  let (_s,t) = W.infer env expr in
  Printf.printf "W type: %s\n" (show_ty t);
  let v = Step.eval expr in
  Printf.printf "eval => %s\n" (Syntax.show_expr v);
  let sc = Types.Forall ([0], Types.TVar 0) in
  let th_x = match Typing_thm.var (Env.extend "x" sc env) "x" sc with Some t -> t | None -> failwith "var" in
  let th = Typing_thm.abs env "x" (EVar "x") (Types.TVar 0) (Types.TVar 0) th_x in
  match Prove.progress_of th with
  | Prove.Value -> print_endline "progress: value"
  | Prove.Step_exists _ -> print_endline "progress: step exists"
