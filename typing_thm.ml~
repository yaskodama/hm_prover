open Syntax
open Types
open Env

type proofnode =
  | PVar of env * string * scheme
  | PAbs of env * string * expr * ty * ty * thm
  | PApp of env * expr * expr * ty * thm * thm
  | PLet of env * string * expr * expr * scheme * ty * thm * thm
  | PIf  of env * expr * expr * expr * ty * thm * thm * thm
and thm = Thm of env * expr * ty * proofnode

let concl (Thm (g,e,t,_)) = (g,e,t)

let inst_ok (_:scheme) (_:ty) = true

let gen_ok (g:env) (t:ty) (sc:scheme) =
  match sc with
  | Forall (as_, t0) ->
      let module S = Set.Make(Int) in
      let rec ftv_ty = function
        | TVar a -> S.singleton a
        | TInt | TBool -> S.empty
        | TFun(t1,t2) -> S.union (ftv_ty t1) (ftv_ty t2)
      in
      let ftv_env =
        Env.M.fold (fun _ (Forall (as1, t1)) acc ->
          S.union (S.diff (ftv_ty t1) (S.of_list as1)) acc
        ) g S.empty
      in
      let gen_set = S.of_list as_ in
      S.disjoint gen_set ftv_env && (t0 = t)

let var g x sc =
  match Env.lookup x g with
  | Some sc' when sc' = sc -> Some (Thm (g, EVar x, Env.instantiate sc, PVar (g, x, sc)))
  | _ -> None

let abs g x e t_arg t_body th_e =
  Thm (g, ELam (x,e), TFun (t_arg, t_body), PAbs (g, x, e, t_arg, t_body, th_e))

let app g e1 e2 t th1 th2 =
  Thm (g, EApp (e1,e2), t, PApp (g, e1, e2, t, th1, th2))

let let_ g x e1 e2 sc t th1 th2 =
  Thm (g, ELet (x,e1,e2), t, PLet (g, x, e1, e2, sc, t, th1, th2))

let if_ g e1 e2 e3 t th1 th2 th3 =
  Thm (g, EIf (e1,e2,e3), t, PIf (g, e1, e2, e3, t, th1, th2, th3))

type rule =
  | RVar of env * string * scheme
  | RAbs of env * string * expr * ty * ty * thm
  | RApp of env * expr * expr * ty * thm * thm
  | RLet of env * string * expr * expr * scheme * ty * thm * thm
  | RIf  of env * expr * expr * expr * ty * thm * thm * thm

let last_rule (Thm (_,_,_,p)) =
  match p with
  | PVar (g,x,sc) -> RVar (g,x,sc)
  | PAbs (g,x,e,t1,t2,th) -> RAbs (g,x,e,t1,t2,th)
  | PApp (g,e1,e2,t,th1,th2) -> RApp (g,e1,e2,t,th1,th2)
  | PLet (g,x,e1,e2,sc,t,th1,th2) -> RLet (g,x,e1,e2,sc,t,th1,th2)
  | PIf (g,e1,e2,e3,t,th1,th2,th3) -> RIf (g,e1,e2,e3,t,th1,th2,th3)
